#!/usr/bin/env python3
"""
video-transcribe — Standalone CLI for Whisper transcription (job-based v2).

Talks directly to the whisper-server Unix socket (Layer 4). Jobs live in
the server, so closing the terminal or a lost connection never kills the
transcription — outputs (.md/.srt) are saved server-side.

Usage:
  video-transcribe transcribe <video> [--lang es] [--model large-v3-turbo]
  video-transcribe batch <dir> [--recursive] [--lang es]
  video-transcribe status [--job <job_id>]
  video-transcribe start-server
  video-transcribe stop-server
"""
import argparse
import json
import os
import socket
import subprocess
import sys
import time
from pathlib import Path

SOCKET_PATH = "/tmp/whisper-server.sock"
WHISPER_SERVER = "/home/b3low-z3r0/Documents/Knowledge/.rag/whisper/whisper_server.py"
WHISPER_VENV_PYTHON = "/home/b3low-z3r0/Documents/Knowledge/.rag/venv/bin/python3"


def ensure_server():
    """Start the whisper-server if not already running."""
    if os.path.exists(SOCKET_PATH):
        try:
            client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            client.settimeout(2)
            client.connect(SOCKET_PATH)
            client.close()
            return True
        except Exception:
            try:
                os.unlink(SOCKET_PATH)
            except OSError:
                pass

    print("Starting whisper-server...")
    try:
        subprocess.Popen(
            [WHISPER_VENV_PYTHON, WHISPER_SERVER],
            stdout=open("/tmp/whisper-server-stdout.log", "w"),
            stderr=open("/tmp/whisper-server-stderr.log", "w"),
            start_new_session=True,
        )
        for _ in range(40):
            time.sleep(0.5)
            if os.path.exists(SOCKET_PATH):
                try:
                    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                    client.settimeout(2)
                    client.connect(SOCKET_PATH)
                    client.close()
                    return True
                except Exception:
                    pass
        return False
    except Exception as e:
        print(f"Failed to start server: {e}", file=sys.stderr)
        return False


def socket_request(req, timeout=30):
    """Send one request to the whisper-server, read one line response."""
    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    client.settimeout(timeout)
    client.connect(SOCKET_PATH)
    client.sendall((json.dumps(req) + "\n").encode("utf-8"))
    response = b""
    while b"\n" not in response:
        data = client.recv(65536)
        if not data:
            break
        response += data
    client.close()
    return json.loads(response.decode("utf-8").strip())


def poll_job(job_id, verbose=True):
    """Poll a job until done/error. Prints progress. Returns final status dict."""
    while True:
        status = socket_request({"id": "poll", "action": "job_status", "job_id": job_id})
        if not status.get("ok"):
            print(f"Error polling: {status.get('error')}", file=sys.stderr)
            return status
        st = status.get("status")
        if st in ("done", "error"):
            return status
        if verbose and st == "running":
            el = status.get("elapsed_seconds", 0)
            print(f"\r  ⏳ transcribiendo... {el:.0f}s", end="", flush=True)
        time.sleep(2)


def cmd_transcribe(args):
    if not ensure_server():
        print("Could not start whisper-server", file=sys.stderr)
        return 1
    if not os.path.exists(args.video_path):
        print(f"Video not found: {args.video_path}", file=sys.stderr)
        return 1

    print(f"Encolando job: {os.path.basename(args.video_path)}")
    started = socket_request({
        "id": "start", "action": "transcribe_job",
        "video_path": args.video_path, "lang": args.lang, "model": args.model,
    }, timeout=15)
    if not started.get("ok"):
        print(f"Error: {started.get('error')}", file=sys.stderr)
        return 1
    job_id = started["job_id"]
    print(f"  job_id: {job_id[:8]}...")

    final = poll_job(job_id)
    print()
    if final.get("status") == "done":
        res = final.get("result", {})
        dur = res.get("duration", 1)
        print(f"✅ {res.get('language')} | {dur:.1f}s audio | "
              f"{len(res.get('segments', []))} segments | RTF={res.get('elapsed_seconds', 0) / dur:.2f}")
        for p in (res.get("transcript_md"), res.get("transcript_srt")):
            if p:
                print(f"  📄 {p}")
        return 0
    print(f"❌ Job failed: {final.get('error')}", file=sys.stderr)
    return 1


def cmd_batch(args):
    if not ensure_server():
        print("Could not start whisper-server", file=sys.stderr)
        return 1

    video_extensions = [".mp4", ".mov", ".mkv", ".avi", ".webm", ".flv", ".m4v"]
    if args.recursive:
        videos = []
        for root, _, files in os.walk(args.directory):
            for f in files:
                if any(f.lower().endswith(ext) for ext in video_extensions):
                    videos.append(os.path.join(root, f))
    else:
        videos = [
            os.path.join(args.directory, f)
            for f in sorted(os.listdir(args.directory))
            if any(f.lower().endswith(ext) for ext in video_extensions)
            and os.path.isfile(os.path.join(args.directory, f))
        ]

    if not videos:
        print(f"No videos found in {args.directory}")
        return 1

    # Dedupe by md5
    import hashlib
    seen = {}
    uniques = []
    for v in videos:
        try:
            with open(v, "rb") as f:
                h = hashlib.md5(f.read()).hexdigest()
        except Exception:
            h = None
        if h and h in seen:
            print(f"⏭️  duplicado (skip): {os.path.basename(v)}")
            continue
        if h:
            seen[h] = v
        uniques.append(v)

    print(f"Encolando {len(uniques)} jobs...")
    job_ids = []
    for v in uniques:
        started = socket_request({
            "id": "start", "action": "transcribe_job",
            "video_path": v, "lang": args.lang, "model": args.model,
        }, timeout=15)
        if started.get("ok"):
            job_ids.append(started["job_id"])
            print(f"  ✅ {os.path.basename(v)} → {started['job_id'][:8]}")
        else:
            print(f"  ❌ {os.path.basename(v)}: {started.get('error')}")

    # Poll all jobs (serialized worker → FIFO)
    remaining = {jid for jid in job_ids}
    while remaining:
        time.sleep(2)
        for jid in list(remaining):
            s = socket_request({"id": "poll", "action": "job_status", "job_id": jid}, timeout=15)
            st = s.get("status")
            if st == "done":
                res = s.get("result", {})
                print(f"  ✅ done: {os.path.basename(res.get('transcript_md',''))} "
                      f"({res.get('duration', 0):.0f}s audio)")
                remaining.discard(jid)
            elif st == "error":
                print(f"  ❌ error: {s.get('error')}")
                remaining.discard(jid)

    print(f"\n📊 Batch complete: {len(job_ids)} jobs, outputs guardados server-side")
    return 0


def cmd_status(args):
    if not ensure_server():
        print("whisper-server not running and could not start")
        return 1
    if args.job:
        s = socket_request({"id": "poll", "action": "job_status", "job_id": args.job}, timeout=15)
        print(json.dumps(s, indent=2))
        return 0
    result = socket_request({"id": "status", "action": "status"}, timeout=10)
    print(json.dumps(result, indent=2))
    return 0


def cmd_start(args):
    if ensure_server():
        print("whisper-server running")
        return 0
    print("Failed to start whisper-server")
    return 1


def cmd_stop(args):
    try:
        result = socket_request({"id": "shutdown", "action": "shutdown"}, timeout=5)
        print(json.dumps(result))
    except Exception as e:
        print(f"stop failed: {e}")
    return 0


def main():
    parser = argparse.ArgumentParser(description="Video transcription with Whisper (job-based)")
    subparsers = parser.add_subparsers(dest="command", required=True)

    p = subparsers.add_parser("transcribe", help="Transcribe a single video (job-based)")
    p.add_argument("video_path")
    p.add_argument("--lang", default="es")
    p.add_argument("--model", default="large-v3-turbo")
    p.set_defaults(func=cmd_transcribe)

    p = subparsers.add_parser("batch", help="Enqueue all videos in a directory")
    p.add_argument("directory")
    p.add_argument("--recursive", action="store_true")
    p.add_argument("--lang", default="es")
    p.add_argument("--model", default="large-v3-turbo")
    p.set_defaults(func=cmd_batch)

    p = subparsers.add_parser("status", help="Server status or job status")
    p.add_argument("--job", default=None, help="Job id to poll")
    p.set_defaults(func=cmd_status)

    p = subparsers.add_parser("start-server")
    p.set_defaults(func=cmd_start)

    p = subparsers.add_parser("stop-server")
    p.set_defaults(func=cmd_stop)

    args = parser.parse_args()
    sys.exit(args.func(args))


if __name__ == "__main__":
    main()
